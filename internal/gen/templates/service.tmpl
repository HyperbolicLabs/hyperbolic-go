{{comment "" (printf "%sService %s" .Name .Doc)}}
type {{.Name}}Service struct {
	t *transport
}
{{range .Methods}}
{{comment "" (printf "%s calls %s %s: %s" .Name .Verb .Path (sentence .Summary))}}
{{- if .Description}}{{if ne .Description .Summary}}
//
{{comment "" .Description}}
{{- end}}{{end}}
{{- if not .Idempotent}}
//
// It is not retried after a failure that may have reached the server. Such a
// failure matches [ErrOutcomeUnknown]: check whether the call took effect
// before making it again.
{{- end}}
{{- if .NullIsNotFound}}
//
// When nothing matches, the error matches [ErrNotFound].
{{- end}}
func (s *{{.Service}}Service) {{.Name}}(ctx context.Context{{if .Params}}, params {{.Params}}{{end}}) ({{if .Pointer}}*{{end}}{{.Result}}, error) {
	c := call{method: http.{{.HTTPMethod}}, path: {{quote .Path}}, idempotent: {{.Idempotent}}{{if .Body}}, body: params{{end}}{{if .Query}}, query: params.query(){{end}}}
{{- if .NullIsNotFound}}
	var raw json.RawMessage
	if err := s.t.do(ctx, c, &raw); err != nil {
		return nil, err
	}
	if isNull(raw) {
		return nil, notFound(c)
	}
	var out {{.Result}}
	if err := json.Unmarshal(raw, &out); err != nil {
		return nil, decodeError(c, err)
	}
	return &out, nil
{{- else}}
	var out {{.Result}}
	if err := s.t.do(ctx, c, &out); err != nil {
		return {{.Zero}}, err
	}
	return {{if .Pointer}}&{{end}}out, nil
{{- end}}
}
{{- if eq .Paginate "page"}}

// {{.Name}}All iterates over the items of every page {{.Name}} returns, from
// params.Page (the first page when unset). It stops at the first error,
// yielding it.
func (s *{{.Service}}Service) {{.Name}}All(ctx context.Context, params {{.Params}}) iter.Seq2[{{.Item}}, error] {
	return pages(params.Page, func(page int) ([]{{.Item}}, bool, error) {
		params.Page = &page
		r, err := s.{{.Name}}(ctx, params)
		if err != nil {
			return nil, false, err
		}
		return r.Items, page < r.TotalPages, nil
	})
}
{{- else if eq .Paginate "cursor"}}

// {{.Name}}All iterates over the items of every page {{.Name}} returns, from
// params.Cursor (the first page when unset). It stops at the first error,
// yielding it.
func (s *{{.Service}}Service) {{.Name}}All(ctx context.Context, params {{.Params}}) iter.Seq2[{{.Item}}, error] {
	return cursors(params.Cursor, func(cursor *string) ([]{{.Item}}, *string, error) {
		params.Cursor = cursor
		r, err := s.{{.Name}}(ctx, params)
		if err != nil {
			return nil, nil, err
		}
		return r.Items, nextCursor(r.NextCursor), nil
	})
}
{{- end}}
{{- if .Query}}

func (p {{.Params}}) query() url.Values {
	q := url.Values{}
{{- range .Query}}
{{- if .Pointer}}
	if p.{{.GoName}} != nil {
		q.Set({{quote .Name}}, fmt.Sprint(*p.{{.GoName}}))
	}
{{- else}}
	q.Set({{quote .Name}}, fmt.Sprint(p.{{.GoName}}))
{{- end}}
{{- end}}
	return q
}
{{- end}}
{{end}}
